---
// One of the app's own pictures (public/shots, from `make renders` via scripts/pictures.mjs), light
// or dark to match the visitor's setting. Sizes are the renders' at 1×.
interface Props {
  name: "off" | "preview" | "on" | "banner";
  alt: string;
  /** The first picture on the page: loaded at once, not lazily. */
  eager?: boolean;
  class?: string;
}
const size = { off: [372, 578], preview: [372, 578], on: [372, 578], banner: [343, 44] } as const;
const { name, alt, eager = false, class: cls } = Astro.props;
const [width, height] = size[name];
---

<picture class={cls}>
  <source srcset={`/shots/${name}-dark.webp`} media="(prefers-color-scheme: dark)" />
  <img src={`/shots/${name}-light.webp`} {alt} {width} {height} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} decoding="async" />
</picture>
