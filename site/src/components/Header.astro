---
// Header, on every page: the app icon and wordmark, the page's sections, GitHub, Install, and the
// pull switch below it for night or day (#41; src/lamp/header.ts, src/theme.mjs).
// Ported from D-Tox's site/src/components/Header.astro; styles in src/styles/site.css.
import { name, repo } from "../site";

const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const sections = [
  { label: "See it", href: "/#see" },
  { label: "⌃⌥C", href: "/#keys" },
  { label: "Privacy", href: "/privacy" },
  { label: "What’s new", href: "/changelog" },
];
---

<header class="hbar"><div class="wrap in">
  <a class="brand" href="/"><img src="/icon-64.png" alt="" width="30" height="30" />{name}</a>
  <nav aria-label="Sections">{sections.map((s) => <a href={s.href} aria-current={s.href === here ? "page" : undefined}>{s.label}</a>)}</nav>
  <div class="right">
    <a class="ghost" href={repo}><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.81.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>GitHub</a>
    <a class="btn sm" href="/#install" data-umami-event="install-header">Install</a>
  </div>
</div></header>
<!-- The pull switch (#41): a ceiling pull switch under the header's right end, in the page margin.
     Drawn here at rest; src/lamp/cord.mjs moves it once the visitor first moves, scrolls, taps or
     types (src/lamp/header.ts). It scrolls away with the page, up under the header. -->
<div class="pull"><div class="wrap"><div class="pull-in">
  <span class="pull-cap" aria-hidden="true"><span class="n">Pull for night</span><span class="d">Pull for day</span></span>
  <button class="sw" type="button" role="switch" aria-checked="false" aria-label="Night" data-lamp>
    <svg viewBox="0 0 48 120" width="48" height="120" aria-hidden="true">
      <defs>
        <linearGradient id="sw-box" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="b0" /><stop offset="1" class="b1" /></linearGradient>
        <linearGradient id="sw-acorn" x1="0" y1="0" x2="1" y2="0"><stop offset="0" class="a0" /><stop offset=".38" class="a1" /><stop offset="1" class="a2" /></linearGradient>
        <radialGradient id="sw-glow"><stop offset="0" class="g0" /><stop offset="1" class="g1" /></radialGradient>
      </defs>
      <g class="plunger"><rect class="ferrule" x="22.5" y="8.5" width="3" height="4.5" rx="1" /></g>
      <path class="box" d="M9-2H39V5.5A4.5 4.5 0 0 1 34.5 10H13.5A4.5 4.5 0 0 1 9 5.5Z" fill="url(#sw-box)" />
      <path class="lip" d="M13.5 9.4H34.5" />
      <ellipse class="glow" cx="24" cy="4.2" rx="9" ry="4.5" fill="url(#sw-glow)" />
      <rect class="lamp" x="19" y="3" width="10" height="2.6" rx="1.3" />
      <ellipse class="hole" cx="24" cy="10" rx="2.4" ry=".9" />
      <path class="cord" data-cord d="M24 11L24 65" />
      <path class="cord-tw" data-cord d="M24 11L24 65" />
      <path class="cord-hit" data-cord d="M24 11L24 65" />
      <g class="acorn" transform="translate(24 65)">
        <path class="body" d="M-1.5 2.2C-1.9 6-4.6 8.6-4.6 12.4-4.6 15.9-2.5 18.4 0 18.4 2.5 18.4 4.6 15.9 4.6 12.4 4.6 8.6 1.9 6 1.5 2.2Z" fill="url(#sw-acorn)" />
        <path class="shine" d="M-2.6 9.6C-3.2 11.4-3.1 13.6-2.2 15.2" />
        <rect class="collar" x="-2.1" y="-.4" width="4.2" height="3" rx="1.2" />
        <circle class="acorn-hit" cx="0" cy="9" r="16" />
      </g>
    </svg>
  </button>
</div></div></div>
<script>
  import "../lamp/header.ts";
</script>
<script is:inline>
  (() => { const h = document.querySelector('.hbar'); const f = () => h.classList.toggle('stuck', scrollY > 8); addEventListener('scroll', f, { passive: true }); f(); })();
</script>
