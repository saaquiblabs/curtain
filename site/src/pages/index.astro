---
// Curtain's page. Leads with Turn off, windows stay (owner's pick on #42, 2026-11-25); names no
// other apps. Built on D-Tox's product page: a serif headline with an italic accent, a sticky
// story that swaps the product as you scroll, a lit footer. Pictures are the real menu from
// `make renders` (site/scripts/menu-pictures.sh). The desk under ⌃⌥C is drawn in CSS with the
// menu's drapes: two panels meeting in the middle in 720 ms, as on the map (CHANGELOG 0.4.0).
import Base from "../layouts/Base.astro";
import Brew from "../components/Brew.astro";
import Menu from "../components/Menu.astro";
import { pages } from "../seo";
import { needs, repo } from "../site";
import { readChangelog } from "../changelog.mjs";

const latest = readChangelog(repo)[0];

const steps = [
  { pic: "off", h: "Dark in half a second.", alt: "The menu at night with the L27h-4A turned off: drapes closed over its tile on the desk map and across its row, which says “Off. Its windows are still there, hidden.” beside a glowing Turn on button.",
    p: "Turn off fades the screen to black and draws the drapes across its row and its tile. Nothing is rearranged, so nothing flashes, and every window waits exactly where it was." },
  { pic: "lit", h: "Your desk, as it really is.", alt: "The menu with both screens on; the pointer rests on the L27h-4A's tile on the desk map, and the tile and its row light up together.",
    p: "With two screens or more the menu opens on a map of them, placed as macOS arranges them and each as bright as the real one. Point at a screen and its row lights up." },
  { pic: "preview-turn-off", h: "See it before you click.", alt: "The pointer on the L27h-4A's Turn off button: its tile on the map is half-covered by drapes, and a line under the map says “Turns L27h-4A black at once. Its windows stay on it.”",
    p: "Point at a button and the map shows its result halfway, with one line saying what will happen. Only on the map, never on a real screen." },
  { pic: "disconnected", h: "Unplugged, without the cable.", alt: "The L27h-4A disconnected: a dashed outline where its tile was on the map, and its row offers Reconnect.",
    p: "Disconnect makes macOS treat a monitor as unplugged: its windows move to your other screen and the monitor sleeps. Reconnect brings it back, along with the menu and your pointer." },
  { pic: "preview-slider", h: "Real brightness, every screen.", alt: "Both screens on, the pointer along the L27h-4A's brightness bar; its tile on the map glows to match.",
    p: "A slider per monitor sets its actual backlight. Monitors that won't listen are dimmed in software instead, and the row says so. Follow the Mac makes them track your MacBook." },
  { pic: "preview-quit", h: "Quit puts everything back.", alt: "The pointer on Quit: the L27h-4A's drapes half open on the map, and the line “Quits Curtain; every screen comes back on.”",
    p: "Quit, log out or stop Curtain any way at all, and every screen comes back on at the brightness it had. It never lets you switch off your last screen." },
];

// Why install it (#42's value copy, 2026-11-25): three everyday reasons, no other apps named.
const reasons = [
  { h: "One screen, nothing unplugged", p: "Just the monitor, or just the MacBook, for a while. No closing the lid, no pulling the cable, no reaching behind the monitor for its button.", icon: "M3 5h12v9H3zM7 18h4M9 14v4M17 9h4v6h-4z" },
  { h: "Dark when you want it", p: "A film, a late night, an hour of focus: ⌃⌥C turns every other screen dark so the one in front of you is all there is. Press it again and they’re back.", icon: "M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" },
  { h: "Monitor brightness from the Mac", p: "A slider or F1 and F2 set your monitor’s own backlight, so you never hunt for its buttons. Follow the Mac makes it keep pace with your MacBook.", icon: "M12 4v2M12 18v2M4 12h2M18 12h2M6.3 6.3l1.4 1.4M16.3 16.3l1.4 1.4M6.3 17.7l1.4-1.4M16.3 7.7l1.4-1.4M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" },
];

// Turn off or Disconnect: the same questions, answered for each (Sources/Screens.swift, top).
// Watts: Lenovo's published figures for the L27h-4A until Tools/measure-power.sh has a clean run.
const ways = [
  { name: "Turn off", for: "For a break, a call, a dark room.", rows: [
    ["Windows", "Stay exactly where they are, hidden."],
    ["The monitor", "Stays awake, black, with its backlight turned right down where it allows."],
    ["Your Mac", "Still draws to it, so nothing on any screen moves."],
    ["Coming back", "Instant: the banner, the menu or ⌃⌥C."],
  ] },
  { name: "Disconnect", for: "For the rest of the day, or just the MacBook.", rows: [
    ["Windows", "Move to your other screen, as if you’d pulled the cable."],
    ["The monitor", "Sleeps, and draws next to nothing."],
    ["Your Mac", "Stops drawing to it. Every screen blinks once while macOS rearranges them."],
    ["Coming back", "Reconnect in the menu wakes it, even after sleep or unlock."],
  ] },
];

const details = [
  { h: "Turn back on, right where you are", p: "After Turn off, a small banner floats on the screen you’re on for a few seconds, even with the menu closed. It never takes focus from the app you’re in.", icon: "M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4" },
  { h: "Brightness keys for monitors", p: "F1 and F2 change the screen under your pointer, with the Mac’s own brightness indicator.", icon: "M12 4v2M12 18v2M4 12h2M18 12h2M6.3 6.3l1.4 1.4M16.3 16.3l1.4 1.4M6.3 17.7l1.4-1.4M16.3 7.7l1.4-1.4M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" },
  { h: "Remembers through sleep", p: "A disconnected screen stays disconnected after sleep or unlock, until you say otherwise.", icon: "M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" },
  { h: "Never your last screen", p: "Turn off steps aside on the only screen that’s on, and says why when you point at it. The MacBook never offers Disconnect: macOS would switch off its keyboard and trackpad.", icon: "M12 3 4 6v6c0 4.4 3.4 8 8 9 4.6-1 8-4.6 8-9V6l-8-3Z" },
  { h: "Made for everyone", p: "VoiceOver reads every screen, slider and switch. With Reduce Motion the drapes fade; Increase Contrast strengthens every edge.", icon: "M12 5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM5 8l7 1.5L19 8M12 9.5V15m0 0-3 6m3-6 3 6" },
  { h: "Light by day, dusk at night", p: "Frosted linen in light mode, twilight with an afterglow in dark, following your Mac.", icon: "M12 3v18M12 3a9 9 0 0 1 0 18" },
];
---

<Base {...pages["/"]}>
  <!-- The hero's menu is the largest thing on a phone's first screen: fetch it with the font, not after the page's HTML. -->
  <link slot="head" rel="preload" as="image" imagesrcset="/menu/off-light-640.webp 640w, /menu/off-light.webp 744w" imagesizes="(max-width: 1000px) min(86vw, 380px), 400px" media="(prefers-color-scheme: light)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" imagesrcset="/menu/off-dark-640.webp 640w, /menu/off-dark.webp 744w" imagesizes="(max-width: 1000px) min(86vw, 380px), 400px" media="(prefers-color-scheme: dark)" fetchpriority="high" />
  <!-- The opening: the page's own curtain, drawn back on every load and reload (hard or not).
       Skipped going Back, coming from another page of this site, and with Reduce Motion. -->
  <script is:inline>
    (() => {
      const nav = performance.getEntriesByType('navigation')[0]?.type;
      let fromHere = false; try { fromHere = new URL(document.referrer).origin === location.origin; } catch {}
      const skip = nav === 'back_forward' || (nav !== 'reload' && fromHere) || matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (skip) document.documentElement.classList.add('drawn');
    })();
  </script>
  <div class="stage-drapes" aria-hidden="true"><span class="sd l"></span><span class="sd r"></span><span class="sd-name">Curtain</span></div>

  <section class="hero wrap">
    <div class="hero-copy">
      <p class="kick">For every screen on your Mac</p>
      <h1>Turn a screen off.<br /><em>Its windows stay.</em></h1>
      <p class="lead">Curtain lives in your menu bar. Any screen goes dark in half a second, with every window right where you left it. And <span class="keys"><kbd>⌃</kbd><kbd>⌥</kbd><kbd>C</kbd></span> darkens every screen but the one you’re working on.</p>
      <div class="cta">
        <Brew />
        <a class="src" href="#install">Or build from source <span aria-hidden="true">→</span></a>
      </div>
      <ul class="facts">
        <li>Free, all of it</li><li>Open source, MIT</li><li>Sends nothing</li><li>{needs.replace(" Ventura or newer", "+")}</li>
      </ul>
    </div>
    <div class="hero-art" aria-hidden="false">
      <div class="halo" aria-hidden="true"></div>
      <Menu name="off" class="hero-menu" eager small sizes="(max-width: 1000px) min(86vw, 380px), 400px" alt="Curtain's menu with the L27h-4A turned off: drapes closed over its screen on the desk map and across its row, with a Turn on button and the line “Off. Its windows are still there, hidden.”" />
      <Menu name="banner" class="hero-banner" width={343} height={44} eager alt="The Turn back on banner: “L27h-4A is off”, a Turn back on button and ⌃⌥C." />
    </div>
  </section>

  <section class="wrap numbers" aria-label="Curtain in numbers">
    <div><p class="n">0.5<span>s</span></p><p>from Turn off to dark</p></div>
    <div><p class="n">0</p><p>windows moved when a screen goes dark</p></div>
    <div><p class="n">1</p><p>shortcut for every screen but yours</p></div>
    <div><p class="n">0</p><p>bytes sent anywhere, ever</p></div>
  </section>

  <section class="wrap why-sec" id="why">
    <header class="sec-h">
      <p class="kick">Why Curtain</p>
      <h2>The screens you want, <em>and only those.</em></h2>
    </header>
    <div class="details why">
      {reasons.map((d) => (
        <article class="dcard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d.icon} /></svg>
          <h3>{d.h}</h3>
          <p>{d.p}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="see wrap" id="see">
    <header class="sec-h">
      <p class="kick">See it</p>
      <h2>A menu you understand <em>by looking.</em></h2>
      <p class="lead">Every picture here is the real menu, drawn by Curtain itself. It matches your Mac: light by day, dusk at night.</p>
    </header>
    <div class="story">
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step" data-i={i}>
            <p class="num">{String(i + 1).padStart(2, "0")}</p>
            <h3>{s.h}</h3>
            <p>{s.p}</p>
            <div class="inline-pic"><Menu name={s.pic} alt={s.alt} /></div>
          </li>
        ))}
      </ol>
      <div class="frame-wrap" aria-hidden="true">
        <div class="frame">
          <div class="halo"></div>
          {steps.map((s, i) => <Menu name={s.pic} alt="" class={`slide${i === 0 ? " on" : ""}`} />)}
        </div>
        <div class="progress"><span class="count"><b>01</b> / {String(steps.length).padStart(2, "0")}</span><span class="bar"><i></i></span></div>
      </div>
    </div>
  </section>

  <section class="keys-sec" id="keys">
    <div class="wrap keys-in">
      <header class="sec-h light">
        <p class="kick">⌃⌥C</p>
        <h2>Every screen but yours. <em>One key.</em></h2>
        <p class="lead">Press <span class="keys"><kbd>⌃</kbd><kbd>⌥</kbd><kbd>C</kbd></span> anywhere on your Mac and every screen except the one you’re working on goes dark. Press it again and they all come back. Try it here, on your keyboard or below.</p>
      </header>
      <div class="desk" data-off="false">
        <div class="screens">
          <div class="mon side"><div class="scr"><span class="dl"></span><span class="dr"></span></div><div class="neck"></div><div class="foot"></div><p>Studio monitor</p></div>
          <div class="mac"><div class="scr you"><span class="here">You’re here</span><span class="dl"></span><span class="dr"></span></div><div class="deck"></div><p>MacBook</p></div>
          <div class="mon side"><div class="scr"><span class="dl"></span><span class="dr"></span></div><div class="neck"></div><div class="foot"></div><p>L27h-4A</p></div>
        </div>
        <div class="desk-ctl">
          <button type="button" class="try" aria-pressed="false" data-umami-event="try-shortcut">
            <span class="keys"><kbd>⌃</kbd><kbd>⌥</kbd><kbd>C</kbd></span>
            <span class="lbl">Turn other screens off</span>
          </button>
          <p class="said" aria-live="polite"></p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap which-sec" id="which">
    <header class="sec-h">
      <p class="kick">Two ways to switch off</p>
      <h2>Turn off or Disconnect? <em>It depends how long.</em></h2>
      <p class="lead">Turn off is quick and keeps everything in place. Disconnect is as good as unplugging, for when you’re done with a monitor for a while. Every monitor row offers both; the MacBook offers Turn off.</p>
    </header>
    <div class="ways">
      {ways.map((w) => (
        <article class="way">
          <h3>{w.name}</h3>
          <p class="for">{w.for}</p>
          <dl>
            {w.rows.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
          </dl>
        </article>
      ))}
    </div>
    <p class="watts">What sleep saves, on the monitor on our desk: Lenovo lists the L27h-4A at 21.7 W in typical use and under 0.5 W asleep (<a href="https://psref.lenovo.com/Product/LenovoMonitors/Lenovo_L27h_4A">Lenovo’s product sheet</a>). Turned off, it sits between the two: awake, with its backlight down. Our own measurements will follow.</p>
  </section>

  <section class="wrap detail-sec">
    <header class="sec-h">
      <p class="kick">The small things</p>
      <h2>Free, all of it. <em>Done properly.</em></h2>
      <p class="lead">No pro tier, no trial, no daily limit. Use it at home or at work, on as many Macs as you like.</p>
    </header>
    <div class="details">
      {details.map((d) => (
        <article class="dcard">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d.icon} /></svg>
          <h3>{d.h}</h3>
          <p>{d.p}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap">
    <div class="private">
      <div class="pv-h">
        <p class="kick">Privacy</p>
        <h2>Sends <em>nothing.</em></h2>
        <p class="lead">Curtain has no network code at all. There is nothing to sign up for, and nothing it could send.</p>
        <a class="ghost" href="/privacy">Read the privacy page <span aria-hidden="true">→</span></a>
      </div>
      <ul class="pv-list">
        <li><b>No accounts, no analytics</b><span>Not in the app, not in the background, not once.</span></li>
        <li><b>Four switches, kept on your Mac</b><span>Follow the Mac, Brightness keys, which screen you disconnected, and whether it asked for a permission. That’s all it remembers.</span></li>
        <li><b>One permission, only if you want it</b><span>Accessibility, so the brightness keys reach Curtain before macOS. Everything else works without it.</span></li>
        <li><b>Open to read</b><span>Every line is on GitHub, under the MIT licence.</span></li>
      </ul>
    </div>
  </section>

  <section class="wrap install" id="install">
    <header class="sec-h">
      <p class="kick">Install</p>
      <h2>In your menu bar <em>in a minute.</em></h2>
      <p class="lead">Needs {needs}. Hardware brightness needs Apple silicon; on Intel Macs Curtain dims monitors in software, and turning screens off works on both.</p>
    </header>
    <ol class="how">
      <li>
        <p class="num">01</p>
        <h3>Paste this in Terminal</h3>
        <Brew />
        <p>No Homebrew yet? Get it from <a href="https://brew.sh">brew.sh</a>. Homebrew builds Curtain on your Mac, so it needs Apple’s command line tools (<code>xcode-select --install</code>, no Xcode).</p>
      </li>
      <li>
        <p class="num">02</p>
        <h3>Open Curtain</h3>
        <p>From Spotlight or /Applications. It has no Dock icon: look for the curtain in your menu bar and click it. Switch on <b>Open at login</b> to have it every day.</p>
      </li>
      <li>
        <p class="num">03</p>
        <h3>Brightness keys, if you like</h3>
        <p>F1 and F2 need <b>Accessibility</b>. The menu shows a link while it’s missing: System Settings › Privacy &amp; Security › Accessibility, then switch on Curtain.</p>
      </li>
    </ol>
    <details class="source">
      <summary>Build from source</summary>
      <pre><code>git clone {repo}.git
cd curtain
make app      # builds build/app.noindex/Curtain.app
make run      # builds it and opens it</code></pre>
      <p>With Apple’s command line tools installed. The first build makes a local signing certificate, so the Accessibility permission survives rebuilds. More in the <a href={repo}>README</a>.</p>
    </details>
    <p class="ver">Latest: <a href={`/changelog?v=${latest.version}`}>Curtain {latest.version}</a>, <time datetime={latest.iso}>{latest.date}</time>. Upgrade with <code>brew upgrade</code>.</p>
  </section>
</Base>

<script is:inline>
  // The story: the step in the middle of the window picks the picture in the frame.
  (() => {
    const steps = [...document.querySelectorAll('.step')], slides = [...document.querySelectorAll('.frame .slide')];
    const count = document.querySelector('.progress b'), bar = document.querySelector('.progress i');
    const show = (i) => {
      slides.forEach((s, j) => s.classList.toggle('on', j === i));
      steps.forEach((s, j) => s.classList.toggle('on', j === i));
      count.textContent = String(i + 1).padStart(2, '0'); bar.style.transform = `scaleX(${(i + 1) / steps.length})`;
    };
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && show(+e.target.dataset.i)), { rootMargin: '-45% 0px -45% 0px' });
    steps.forEach((s) => io.observe(s)); show(0);
  })();

  // ⌃⌥C on the page: the drapes close over every screen but yours, and open again.
  (() => {
    const desk = document.querySelector('.desk'), btn = desk.querySelector('.try'), lbl = btn.querySelector('.lbl'), said = desk.querySelector('.said');
    const set = (off) => {
      desk.dataset.off = off; btn.setAttribute('aria-pressed', off);
      lbl.textContent = off ? 'Turn them back on' : 'Turn other screens off';
      said.textContent = off ? '2 screens are off. Their windows are still there.' : 'Every screen is on.';
    };
    btn.addEventListener('click', () => set(desk.dataset.off !== 'true'));
    addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.altKey && !e.metaKey && e.code === 'KeyC') { e.preventDefault(); set(desk.dataset.off !== 'true'); desk.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
    });
  })();
</script>

<style is:global>
  /* the opening drapes */
  .stage-drapes{position:fixed;inset:0;z-index:90;pointer-events:none;display:grid;place-items:center;overflow:hidden}
  .stage-drapes .sd{position:absolute;top:0;bottom:0;width:50.5%;
    background:linear-gradient(90deg,rgb(0 0 0 / .0),rgb(0 0 0 / .12)),repeating-linear-gradient(90deg,var(--drape-a) 0 14px,var(--drape-b) 22px,var(--drape-a) 30px);
    animation:part 1.15s var(--drape) .35s forwards}
  .stage-drapes .l{left:0;box-shadow:12px 0 30px rgb(0 0 0 / .18)}
  .stage-drapes .r{right:0;--to:100%;box-shadow:-12px 0 30px rgb(0 0 0 / .18)}
  .stage-drapes .l{--to:-100%}
  .stage-drapes .sd-name{position:relative;font:italic 400 clamp(54px,9vw,120px)/1 var(--disp);color:var(--text);animation:fade .5s ease .2s forwards}
  @keyframes part{to{transform:translateX(var(--to))}}
  @keyframes fade{to{opacity:0;transform:scale(.97)}}
  .drawn .stage-drapes{display:none}

  .hero{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.75fr);gap:clamp(32px,5vw,80px);align-items:center;min-height:calc(100svh - 68px);padding-block:clamp(40px,6vw,72px)}
  .hero-copy{display:grid;grid-template-columns:minmax(0,1fr);gap:24px;justify-items:start}
  .hero h1{font-size:clamp(46px,5.4vw,80px)}
  .hero-copy .lead{max-width:34rem}
  .cta{display:flex;flex-wrap:wrap;align-items:center;gap:14px 22px;margin-top:6px}
  .src{font:600 14.5px/1 var(--sans);color:var(--t2);text-decoration:none}.src:hover{color:var(--text)}
  .facts{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:8px 22px;font-size:13.5px;color:var(--t3)}
  .facts li{display:inline-flex;align-items:center;gap:8px}
  .facts li::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--acc);box-shadow:0 0 0 3px rgb(var(--acc-rgb) / .18)}
  .hero-art{position:relative;justify-self:center;width:min(100%,400px)}
  .halo{position:absolute;inset:-12% -22%;z-index:-1;border-radius:50%;background:radial-gradient(closest-side,var(--glow),transparent 100%)}
  .hero-menu img{width:100%;border-radius:22px;box-shadow:var(--shadow-lg)}
  .hero-banner{position:absolute;left:-20%;bottom:-5%;width:86%}
  .hero-banner img{width:100%;border-radius:999px;box-shadow:var(--shadow-lg)}
  @media (prefers-reduced-motion:no-preference){
    .hero-menu{animation:float 8s ease-in-out infinite}
    .hero-banner{animation:rise .6s var(--ease) 1.5s both}
    .drawn .hero-banner{animation-delay:.6s}
    @keyframes float{50%{transform:translateY(-8px)}}
    @keyframes rise{from{opacity:0;transform:translateY(12px)}}
  }

  .numbers{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line);margin-bottom:clamp(80px,10vw,140px)}
  .numbers>div{padding:28px clamp(12px,2vw,28px);display:grid;gap:6px;color:var(--t2);font-size:14.5px;line-height:1.45}
  .numbers>div+div{border-left:1px solid var(--line)}
  .numbers .n{font:400 clamp(44px,5vw,64px)/1 var(--disp);color:var(--text);letter-spacing:-.02em}
  .numbers .n span{font-style:italic;color:var(--acc);font-size:.6em;margin-left:2px}

  .sec-h{display:grid;gap:16px;max-width:44rem;margin-bottom:clamp(40px,5vw,64px)}

  /* the story */
  .story{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1fr);gap:clamp(32px,6vw,96px)}
  .steps{list-style:none;margin:0;padding:0}
  .step{min-height:78vh;display:grid;align-content:center;gap:12px;padding-left:28px;border-left:1px solid var(--line);opacity:.38;transition:opacity .4s,border-color .4s}
  .step.on{opacity:1;border-color:var(--acc)}
  .step .num{font:italic 400 20px/1 var(--disp);color:var(--acc)}
  .step h3{font:400 clamp(30px,3vw,40px)/1.08 var(--disp);letter-spacing:-.015em}
  .step p:not(.num){color:var(--t2);max-width:26rem}
  .inline-pic{display:none}
  .frame-wrap{position:sticky;top:max(90px,calc(50vh - 330px));align-self:start;display:grid;gap:18px;justify-items:center}
