---
// Privacy: shape from D-Tox's site/src/pages/privacy.astro. Keep it true to what the app stores
// (UserDefaults keys in Sources/) and change it in the same PR as anything that changes that.
import Base from "../layouts/Base.astro";
import { pages } from "../seo";
import { analytics, email, mailto, name, repo } from "../site";

const updated = { iso: "2026-11-25", text: "25 November 2026" };
const app: [string, string][] = [
  ["What it collects", "Nothing."],
  ["What it sends", "Nothing. It makes no network requests at all."],
  ["What it stores", "Its settings on your Mac (macOS's own preferences for the app): each screen's brightness, which screens are off, which monitors ignore DDC, and your switches (Follow the Mac, Brightness keys)."],
  ["What it can reach", "Your screens: their brightness, colours and on or off. With the Accessibility permission, which only the brightness keys need, it also sees key presses, to catch F1 and F2 before macOS does. It keeps none of them."],
  ["Tracking, ads, analytics", "None."],
  ["Third parties", "None."],
];
---

<Base {...pages["/privacy"]}>
  <article class="wrap pv">
    <header class="head">
      <p class="label">Privacy</p>
      <h1>{name} sends nothing anywhere.</h1>
      <p class="lead">Last updated <time datetime={updated.iso}>{updated.text}</time>.</p>
    </header>

    <section class="prose" aria-labelledby="short">
      <h2 id="short">The short version</h2>
      <p>The app collects nothing and sends nothing. It keeps its settings on your Mac. That's all it stores.</p>
    </section>

    <section class="prose" aria-labelledby="app">
      <h2 id="app">The app</h2>
      <div class="card"><table>
        <tbody>
          {app.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
        </tbody>
      </table></div>
      <p>Uninstall it and clear what's left with <code>defaults delete com.saaquiblabs.curtain</code>. The code is open: <a href={repo}>read it on GitHub</a>.</p>
    </section>

    <section class="prose" aria-labelledby="site">
      <h2 id="site">This website</h2>
      <p>This site has no accounts, no forms and no cookies.</p>
      {analytics.websiteId
        ? <p>It counts visits with Umami, which we run ourselves. Umami notes the page, the site that sent you, your browser, operating system, device type, screen size, language and country. It sets no cookies and does not store your IP address.</p>
        : <p>It does not count visits.</p>}
      <p>Our web server logs each request (IP address, page, time and browser) to keep the site up and to stop abuse. The logs are kept for a short time, then overwritten. The server is ours, in Mumbai, India, on Oracle Cloud.</p>
    </section>

    <section class="prose" aria-labelledby="contact">
      <h2 id="contact">Questions</h2>
      <p>Write to <a href={mailto}>{email}</a> or <a href={`${repo}/issues`}>open an issue on GitHub</a>. When this policy changes, the date at the top changes too.</p>
    </section>
  </article>
</Base>

<style>
  .pv { display: grid; gap: clamp(40px, 5vw, 64px); }
  .card { border-radius: 20px; background: var(--surf); border: 1px solid var(--line); padding: 6px 24px; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; vertical-align: top; padding: 16px 0; border-bottom: 1px dashed var(--line2); }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  th { font-weight: 600; color: var(--text); width: 34%; padding-right: 24px; }
  @media (max-width: 560px) {
    th, td { display: block; width: auto; padding: 0; border: 0; }
    td { margin-top: 4px; }
    tr { display: block; padding: 14px 0; border-bottom: 1px dashed var(--line2); }
    tr:last-child { border-bottom: 0; }
  }
</style>
